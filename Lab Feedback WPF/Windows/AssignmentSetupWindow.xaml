<Window x:Class="Lab_Feedback_WPF.Windows.AssignmentSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assignment Setup" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="RowBackground" Value="#2D2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Course and Title -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Course" FontWeight="Bold"/>
                <ComboBox x:Name="cmbCourse" IsEditable="True" Text="CS101" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Assignment Title" FontWeight="Bold"/>
                <TextBox x:Name="txtTitle" Text="Binary Search Tree Lab"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Load Saved" Width="120" Click="LoadSaved_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="0" Margin="0,45,0,0" HorizontalAlignment="Left">
            <TextBlock Text="Saved Courses" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbSavedCourses" Width="220" SelectionChanged="SavedCourses_SelectionChanged" />
        </StackPanel>

        <!-- Requirements -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Assignment Requirements / Context" FontWeight="Bold"/>
            <TextBox x:Name="txtRequirements" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="200"
                     Text="Paste assignment overview and requirements here..."/>
        </StackPanel>

        <!-- Rubric -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Rubric (Method → Points)" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="+ Add Item" Width="100" Click="AddRubricItem_Click"/>
                    <Button Content="− Remove" Width="100" Click="RemoveRubricItem_Click" Background="#C5000050"/>
                    <Button Content="Parse from Text" Width="120" Click="ParseRubric_Click"/>
                </StackPanel>
            </StackPanel>

            <DataGrid x:Name="dgRubric" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="True"
                      CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Method/Feature" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Max Points" Binding="{Binding MaxPoints}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="txtTotalPoints" 
                       Text="Total: 0 points" 
                       VerticalAlignment="Center" 
                       Margin="0,0,20,0"
                       FontWeight="Bold"
                       Foreground="#4EC9B0"/>
            <Button Content="Save Assignment" Width="150" Click="Save_Click"/>
            <Button Content="Cancel" Width="100" Click="Cancel_Click" Background="#3E3E42"/>
        </StackPanel>
    </Grid>
</Window>

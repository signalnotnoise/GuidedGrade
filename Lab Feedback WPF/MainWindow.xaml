<ui:FluentWindow
    x:Class="Lab_Feedback_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:local="clr-namespace:Lab_Feedback_WPF.Converters"
    Title="Lab Feedback" Height="800" Width="1200">

    <ui:FluentWindow.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
        </Style>

        <Style x:Key="SidePanelTabStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="2,0,0,0"
                        BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>

        <!-- Violations Panel -->
        <Border x:Key="ViolationsPanel" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                    Text="Violations"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#CCCCCC"
                    Margin="0,0,0,8"/>
                <ListView x:Name="violationsList"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontFamily="Consolas"
                    FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- File Info Panel -->
        <Border x:Key="FileInfoPanel" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                    Text="File Info"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#CCCCCC"
                    Margin="0,0,0,8"/>
                <StackPanel x:Name="fileInfoStack">
                    <TextBlock x:Name="fileInfoName"
                        Foreground="#CCCCCC"
                        FontSize="12"
                        TextWrapping="Wrap"/>
                    <TextBlock x:Name="fileInfoPath"
                        Foreground="#666666"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TitleBar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Violations Panel -->
            <RowDefinition Height="Auto"/>
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Title Bar (replaces your custom titleBar panel) -->
        <ui:TitleBar Grid.Row="0" Title="Lab Feedback">
            <ui:TitleBar.Header>
                <DockPanel LastChildFill="True">
                    <Menu DockPanel.Dock="Left">
                        <MenuItem Header="File">
                            <MenuItem Header="Open Folder" Click="OpenFolderMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="Tools">
                            <MenuItem Header="Violations Settings..." Click="SettingsMenuItem_Click"/>
                            <MenuItem Header="LLM Configuration..." Click="LLMSettingsMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Setup Assignment..." Click="SetupAssignmentMenuItem_Click"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,12,0" DockPanel.Dock="Right">
                        <TextBlock Text="Course" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbSavedCourses" Width="180" Margin="0,0,12,0" SelectionChanged="SavedCourse_SelectionChanged"/>
                        <TextBlock Text="Assignment" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbSavedAssignments" Width="220" SelectionChanged="SavedAssignment_SelectionChanged"/>
                    </StackPanel>
                </DockPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content (replaces your SplitContainers) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="sidePanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Students & File Explorer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Students section: Takes 1 part (max) -->
                    <RowDefinition Height="1*" MaxHeight="300"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Explorer section: Takes 1 part (min guaranteed) -->
                    <RowDefinition Height="1*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- Students List -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="STUDENTS" Foreground="#999999"
                               Margin="5,4,5,4" FontWeight="Bold" FontSize="11"/>
                    <ListBox x:Name="listBoxStudents"
                             Background="#1E1E1E"
                             BorderThickness="0"
                             Foreground="#CCCCCC"
                             Margin="0,0,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="ListBoxStudents_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" 
                                           Padding="4,2"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" 
                              Height="4"
                              HorizontalAlignment="Stretch"
                              Background="#3F3F46"
                              ResizeDirection="Rows"/>

                <!-- File Explorer Tree -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="EXPLORER" Foreground="#999999"
                               Margin="5,4,5,8" FontWeight="Bold" FontSize="11"/>
                    <TreeView x:Name="fileTreeView"
                              Background="#1E1E1E"
                              BorderThickness="0"
                              Foreground="#CCCCCC"
                              SelectedItemChanged="FileTreeView_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- TreeViewItem style -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header -->
                                                <Border x:Name="Border"
                                                        Grid.Row="0"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Expander toggle -->
                                                        <ToggleButton x:Name="Expander"
                                                                      Width="16"
                                                                      Height="16"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press"
                                                                      Background="Transparent"
                                                                      BorderThickness="0">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <TextBlock x:Name="ExpanderIcon"
                                                                                           FontFamily="Segoe MDL2 Assets"
                                                                                           FontSize="10"
                                                                                           Foreground="#999999"
                                                                                           Text="&#xE76C;"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ExpanderIcon" Property="Text" Value="&#xE70D;"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>

                                                        <!-- Icon (folder or file) -->
                                                        <TextBlock x:Name="Icon"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="#DCAA6F"
                                                                   Text="&#xE8B7;"
                                                                   Margin="2,0,4,0"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Content -->
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Children -->
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Margin="16,0,0,0"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <!-- Hide expander if no children -->
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <!-- Collapsed state -->
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <!-- Selected state -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                                </Trigger>
                                                <!-- Hover state -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                                </Trigger>
                                                <!-- File icon (when no children) -->
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Icon" Property="Text" Value="&#xE8A5;"/>
                                                    <Setter TargetName="Icon" Property="Foreground" Value="#569CD6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Checkbox for files only (not directories) -->
                                    <CheckBox IsChecked="{Binding IsCheckedForAnalysis}" 
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer" Click="OpenTreeItemInExplorer_Click"/>
                                <MenuItem Header="Refresh" Click="RefreshTreeView_Click"/>
                                <Separator/>
                                <MenuItem Header="Analyze Selected Files with LLM" Click="AnalyzeWithLLM_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Grid>

            <GridSplitter 
                Grid.Column="1" 
                Width="1"
                HorizontalAlignment="Stretch"
                Background="#3F3F46" />

            <!-- Right Panel: Code View -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Background="#272822">

                    <Button x:Name="buttonOpenGrading"
                        DockPanel.Dock="Right"
                        Width="28"
                        Height="28"
                        Padding="0"
                        ToolTip="Open Grading Panel"
                        Background="#272822"
                        BorderThickness="0"
                        VerticalAlignment="Center">

                        <TextBlock Text="&#xE762;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </Button>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="panelFileTabs" Orientation="Horizontal" Background="#272822"/>
                    </ScrollViewer>

                </DockPanel>

                <Grid>
                    <avalon:TextEditor
                        x:Name="codeEditor"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        ShowLineNumbers="True"
                        Background="#272822"
                        Foreground="#F8F8F2">
                        <avalon:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Grade Selected Section..." Click="GradeSection_Click"/>
                            </ContextMenu>
                        </avalon:TextEditor.ContextMenu>
                    </avalon:TextEditor>

                    <Canvas x:Name="commentOverlay"
                            Background="{x:Null}"
                            IsHitTestVisible="True"
                            Panel.ZIndex="2" />

                    <Border x:Name="emptyStateOverlay"
                        Background="#272822"
                        Visibility="Visible"
                        Panel.ZIndex="1">
                        <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.4">
                            <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,16"/>
                            <TextBlock Text="No file selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,8"/>
                            <TextBlock Text="1. Select a student from the list"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,4"/>
                            <TextBlock Text="2. Select an assignment to view its code"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="sidePanelSplitter"
              Grid.Column="3"
              Width="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="#3F3F46"
              Visibility="Collapsed"/>

            <!-- Side Panel Content: Kept empty for future use -->
            <Border x:Name="sidePanelContent"
                Grid.Column="4"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="1,0,0,0">
                <TextBlock Text="Side panel available for other content"
                          Foreground="#666"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

        </Grid>

        <!-- Violations Panel -->
        <Border Grid.Row="2" 
                x:Name="violationsPanel"
                Background="#1E1E1E" 
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                MaxHeight="200"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with close button -->
                <DockPanel Grid.Row="0" Background="#2D2D30" Height="28">
                    <Button DockPanel.Dock="Right"
                            Width="28"
                            Height="28"
                            Click="CloseViolationsPanel_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Close Violations Panel"
                            Cursor="Hand">
                        <TextBlock Text="&#xE711;" 
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#CCCCCC"/>
                    </Button>

                    <TextBlock Text="Violations"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"/>
                </DockPanel>

                <!-- Violations List -->
                <ListView Grid.Row="1"
                          x:Name="violationsList"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#CCCCCC"
                          FontFamily="Consolas"
                          FontSize="12"
                          Padding="8"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="ViolationsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LineNumber, StringFormat='Line {0}:'}" Foreground="#569CD6"/>
                                <Run Text=" "/>
                                <Run Text="{Binding MatchedText}" Foreground="#CE9178"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Context}" Foreground="#9CDCFE"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
        Height="24"
        Background="#2D2D30"
        BorderBrush="#3F3F46"
        BorderThickness="0,1,0,0">
            <StackPanel 
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="15,0,15,3">

                <TextBlock Text="Builds: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusBuilds" Text="0" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Score: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusScore" Text="0" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Violations: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusViolations"
                   Text="0"
                   Style="{StaticResource StatusValueStyle}"
                   ToolTipService.ShowDuration="30000"
                   ToolTipService.InitialShowDelay="500"
                   MouseLeftButtonDown="StatusViolations_Click"
                   Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>